# ================================
# Smart Workout AI - Environment Variables
# ================================
# Copy file này thành .env và chỉnh sửa giá trị

# --- App ---
APP_NAME=SmartWorkoutAI
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
# Danh sách JSON. "*" chỉ dùng khi APP_ENV=development
CORS_ORIGINS=["*"]

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smart_workout
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=smart_workout_db
# true = in câu SQL ra log (chỉ để debug)
DB_ECHO=false

# --- MongoDB ---
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=smart_workout_docs

# --- Redis ---
# Dùng Redis trên VM team-stack: REDIS_HOST=100.72.175.1 (cần bật Tailscale). Không có mật khẩu.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Cache permission perm:{user_id} (doc 04 §2.4) và timeout kết nối Redis
PERMISSION_CACHE_TTL_SECONDS=300
REDIS_SOCKET_TIMEOUT_SECONDS=2

# --- JWT Authentication ---
# Chỉ dùng cho dev. Ngoài development PHẢI là chuỗi ngẫu nhiên >= 32 ký tự (app từ chối khởi động nếu không)
JWT_SECRET_KEY=your-super-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Auth policy (doc 04 §4.2, §6.2) ---
REQUIRE_EMAIL_VERIFICATION=false
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# --- AWS S3 (Object Storage) ---
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=smart-workout-media
AWS_S3_REGION=ap-southeast-1

# --- Object Storage ---
# local = dev chưa có S3 (ghi file vào LOCAL_STORAGE_DIR, giữ nguyên bucket/object_key); s3 = dùng AWS_* ở trên
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.storage
# Font TTF có dấu tiếng Việt cho thẻ báo cáo (Docker: /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf)
REPORT_FONT_PATH=

# --- Message Queue ---
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# CELERY_BROKER_URL=redis://localhost:6379/1

# --- AI Services ---
AI_SERVICE_URL=http://localhost:8001
# Timeout gọi GET {AI_SERVICE_URL}/health (lỗi chỉ đánh dấu degraded)
AI_HEALTH_TIMEOUT_SECONDS=2
