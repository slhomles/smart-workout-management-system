# ===========================
# Smart Workout AI - .gitignore
# ===========================

# ---- Python / FastAPI ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
.venv/
env/
.env
.env.local
.env.*.local

# PyTest
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# MyPy
.mypy_cache/

# ---- Node.js / Frontend ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock

# Build output
dist/
build/
.next/
out/

# ---- AI / ML Models ----
*.pt
*.pth
*.onnx
*.tflite
*.h5
*.pkl
*.joblib
*.weights
*.caffemodel

# Datasets (too large for git)
datasets/**/*.jpg
datasets/**/*.jpeg
datasets/**/*.png
datasets/**/*.mp4
datasets/**/*.avi
datasets/**/*.csv

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Docker ----
docker-compose.override.yml

# ---- Logs ----
logs/
*.log

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Secrets ----
*.pem
*.key
*.crt
secrets/
